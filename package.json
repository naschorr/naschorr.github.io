{
  "name": "nickschorr.com",
  "version": "1.16.0",
  "scripts": {
    "ng": "ng",
    "prestart": "npm run image-resizer && npm run image-format-converter && npm run image-exif-cleaner && npm run generate-thumbnails && npm run image-metadata-processor",
    "start": "ng serve --host 0.0.0.0",
    "prebuild": "npm run image-resizer && npm run image-format-converter && npm run image-exif-cleaner && npm run generate-thumbnails && npm run image-metadata-processor",
    "build": "ng build",
    "build-stats": "ng build --stats-json",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "analyze": "esbuild-visualizer --open=true --metadata dist/nickschorr.com/stats.json",
    "image-resizer": "cd src/ && node scripts/image-resizer.js",
    "image-format-converter": "cd src/ && node scripts/image-format-converter.js",
    "generate-thumbnails": "cd src/ && node scripts/thumbnail-generator.js",
    "image-metadata-processor": "cd src/ && node scripts/image-metadata-processor.js",
    "image-exif-cleaner": "cd src/ && node scripts/image-exif-cleaner.js"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.3",
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/material": "^22.2.4",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-browser-dynamic": "^22.2.3",
    "@angular/router": "^22.2.3",
    "autoprefixer": "^10.4.16",
    "echarts": "^5.4.3",
    "ngx-echarts": "^17.1.0",
    "postcss": "^8.4.32",
    "rxjs": "~7.8.0",
    "tailwindcss": "^3.4.0",
    "tslib": "^2.3.0",
    "ws": "^8.17.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.3",
    "@types/jasmine": "~5.1.0",
    "angular-cli-ghpages": "^2.0.3",
    "esbuild-visualizer": "^0.6.0",
    "jsdom": "^29.0.1",
    "ng-packagr": "^22.2.5",
    "sharp": "^0.33.2",
    "typescript": "~6.0.3",
    "vitest": "^4.1.2"
  }
}